{
  "info": {
    "_postman_id": "wh-security-collection-v1",
    "name": "Lead Management - Webhook Security & Ingestion Suite",
    "description": "Complete Postman collection for testing and integrating Lead Management Webhooks.\nCovers Dual-Channel Protection: Frontend Website Forms (Public Token, Honeypot, Speed Trap, Domain Whitelist) and Backend Server Integrations (HMAC-SHA256 Signatures, Bearer Secret Key, Key Rotation), plus IndiaMART, TradeIndia, Facebook, and Justdial.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
