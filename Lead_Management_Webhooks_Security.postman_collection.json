    {
      "name": "2. Backend Server-to-Server (HMAC & Bearer)",
      "description": "Server-to-server webhook ingestion for Zapier, Webflow Server, WordPress PHP, Node.js or Python backend servers.",
      "item": [
        {
          "name": "2.1 HMAC-SHA256 Signed Submission (Auto-Calculated)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Automatically compute HMAC-SHA256 signature using CryptoJS",
                  "const secret = pm.environment.get(\"webhook_secret\") || \"whsec_1784d478d7f87e5ad89f27479b382cd45cbf4a06\";",
                  "const rawBody = pm.request.body.raw;",
                  "const hash = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Webhook-Signature\", value: \"sha256=\" + hash });",
                  "console.log(\"Calculated HMAC Signature: sha256=\" + hash);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Security mode is backend_hmac_verified\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.security_mode).to.eql(\"backend_hmac_verified\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Signature",
                "value": "sha256={{dynamic_sig}}",
                "description": "Auto-calculated by Pre-request Script using HMAC-SHA256"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Vikramaditya Singhania\",\n  \"phone\": \"9123456780\",\n  \"email\": \"vikram@singhaniapipes.com\",\n  \"company_name\": \"Singhania Seamless Pipes Pvt Ltd\",\n  \"city\": \"Kolkata\",\n  \"product_inquired\": \"High Pressure Industrial Valves\",\n  \"inquiry_message\": \"Lead routed via Zapier backend integration from landing page.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/website/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "website", "{{tenant_id}}"]
            },
            "description": "Standard Stripe/GitHub style HMAC SHA-256 webhook signature. Postman computes the signature on the fly using your company secret key."
          }
        },
        {
          "name": "2.2 Bearer Secret Key Submission",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().security_mode).to.eql(\"backend_hmac_verified\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{webhook_secret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Deepak Aggarwal\",\n  \"phone\": \"9812345678\",\n  \"email\": \"deepak@aggarwalwires.com\",\n  \"company_name\": \"Aggarwal Wire Industries\",\n  \"city\": \"Chandigarh\",\n  \"product_inquired\": \"Copper Wire Drawing Machine\",\n  \"inquiry_message\": \"Lead sent via server-side Bearer token auth.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/website/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "website", "{{tenant_id}}"]
            },
            "description": "Backend-to-backend call authenticated with private secret key via Authorization: Bearer header."
          }
        },
        {
          "name": "2.3 Tampered Payload / Invalid Signature (Blocked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().detail).to.include(\"HMAC Webhook Signature mismatch\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Webhook-Signature",
                "value": "sha256=invalid_counterfeit_signature_hash_attempt"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Tampered Lead\",\n  \"phone\": \"9991112233\",\n  \"inquiry_message\": \"Payload intercepted and modified\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/website/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "website", "{{tenant_id}}"]
            },
            "description": "Verifies that tampering with payload or passing an incorrect signature is rejected with 401."
          }
        }
      ]
    },
    {
      "name": "3. Token Management & Domain Whitelisting",
      "description": "Company credentials management, token regeneration, and domain restriction controls.",
      "item": [
        {
          "name": "3.1 Get Company Integrations & Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.integrations && json.integrations.website) {",
                  "    pm.environment.set(\"webhook_token\", json.integrations.website.webhook_token);",
                  "    pm.environment.set(\"webhook_secret\", json.integrations.website.secret_key);",
                  "    console.log(\"Updated Postman Environment Tokens!\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}/integrations",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}", "integrations"]
            },
            "description": "Fetches company credentials and automatically populates Postman environment variables 'webhook_token' and 'webhook_secret'."
          }
        },
        {
          "name": "3.2 Regenerate Security Keys (Instant Invalidation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Keys regenerated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.webhook_token).to.be.a(\"string\");",
                  "    pm.expect(json.secret_key).to.be.a(\"string\");",
                  "    pm.environment.set(\"webhook_token\", json.webhook_token);",
                  "    pm.environment.set(\"webhook_secret\", json.secret_key);",
                  "    console.log(\"Rotated keys saved into environment\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}/integrations/regenerate-keys?provider=website",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}", "integrations", "regenerate-keys"],
              "query": [
                {
                  "key": "provider",
                  "value": "website"
                }
              ]
            },
            "description": "Regenerates both public webhook token and private secret key. Immediately invalidates old tokens in case of URL leak."
          }
        },
        {
          "name": "3.3 Configure Allowed Website Domains",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Integrations updated with allowed domains\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"integrations\": {\n    \"website\": {\n      \"is_enabled\": true,\n      \"allowed_domains\": [\"https://mycompany.com\", \"https://landingpage.in\"]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/tenants/{{tenant_id}}/integrations",
              "host": ["{{base_url}}"],
              "path": ["tenants", "{{tenant_id}}", "integrations"]
            },
            "description": "Sets allowed domains so that frontend form submissions from other unauthorized origins/bots are rejected."
          }
        }
      ]
    },
