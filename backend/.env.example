# =============================================================================
#  Lead-to-Cash backend configuration
#  Copy to ".env" for local development:   python -m app.cli init-env
#  NEVER commit a real .env file. In production use a secret store / Kubernetes Secret.
# =============================================================================

PROJECT_NAME="Lead-to-Cash LMS"
API_V1_STR="/api/v1"

# development | staging | production      (production enforces HTTPS-only cookies, hides API docs, strict CORS)
ENVIRONMENT=development
TIMEZONE=Asia/Kolkata

# --- Secrets (required; generate with: python -m app.cli generate-keys) --------------------------
# JWT signing key: private random value, at least 32 characters
SECRET_KEY=
# Fernet key(s) used to encrypt stored integration / gateway credentials and 2FA seeds.
# Comma separated: the first key encrypts, all keys decrypt (add a new key in front to rotate).
ENCRYPTION_KEYS=

# --- Database --------------------------------------------------------------------------------------
# Use a dedicated database user with a strong, unique password and restrict network access (IP allow-list).
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="lead_management_db"

# --- Web application ----------------------------------------------------------------------------------
# Public address of the front-end (used in e-mails) and the exact origins allowed to call the API
FRONTEND_BASE_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Host names this API answers to, e.g. "leadcrm.example.com" ("*" = any, development only)
ALLOWED_HOSTS="*"
# Number of trusted reverse proxies in front of the API (1 for one ingress / nginx, 0 when exposed directly)
FORWARDED_ALLOW_HOPS=1

# --- Sessions & sign-in protection --------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# An account is locked for LOCKOUT_MINUTES after MAX_FAILED_LOGINS wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Sign-in attempts per minute: per account (tight) and per network address (generous - an office shares one address)
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=60
PASSWORD_MIN_LENGTH=10
TEMP_PASSWORD_VALID_DAYS=7
# Roles that must use two-factor authentication (comma separated), e.g. "super_admin,company_admin"
MFA_REQUIRED_ROLES=super_admin

# --- First platform administrator (optional, first start only - remove afterwards) --------------------
# BOOTSTRAP_SUPERADMIN_EMAIL=
# BOOTSTRAP_SUPERADMIN_PASSWORD=

# --- Platform e-mail relay (optional: welcome e-mails for new companies, password reset links) --------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="LeadCRM <no-reply@example.com>"

# --- Upgrade from versions that stored readable passwords ----------------------------------------------
# force_change (default) | disable   - see SECURITY.md "Upgrading"
LEGACY_PASSWORD_MIGRATION=force_change
