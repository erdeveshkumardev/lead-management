            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Simulate form loaded 3.5 seconds ago (Human Typing Speed)",
                  "const renderTime = (Date.now() / 1000) - 3.5;",
                  "pm.variables.set(\"human_render_time\", renderTime.toString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lead successfully captured\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.lead_id).to.not.eql(\"bot_filtered\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Rajesh Sharma\",\n  \"phone\": \"9876543210\",\n  \"email\": \"rajesh.sharma@apexforge.com\",\n  \"company_name\": \"Apex Engineering Ltd\",\n  \"city\": \"Ahmedabad\",\n  \"product_inquired\": \"CNC Milling Center 3-Axis\",\n  \"inquiry_message\": \"Please share quotation with installation and 1 year warranty details.\",\n  \"_render_time\": {{human_render_time}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks/website/{{tenant_id}}?token={{webhook_token}}",
              "host": ["{{base_url}}"],
              "path": ["webhooks", "website", "{{tenant_id}}"],
              "query": [
                {
                  "key": "token",
                  "value": "{{webhook_token}}",
                  "description": "Company Public Webhook Token"
                }
              ]
            },
            "description": "Submits a genuine human inquiry with valid phone, public token, and human speed threshold."
          }
        },
